# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=production

# Postgres connection string (Neon: Connect button on the dashboard). Keep it private.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random text (at least 32 characters). On Render, use the "Generate" button for each.
JWT_SECRET=change-me-to-long-random-text-32-chars-min
ENC_KEY=change-me-to-different-long-random-text-32-chars-min

# First admin account, created on first start if no admin exists
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-password

# Where clients send crypto (shown on the dashboard)
PAY_NETWORK=USDT (TRC20)
PAY_ADDRESS=your-wallet-address
PAY_AMOUNT=100

# Contact details shown to clients (can also be changed in the admin panel)
CONTACT_EMAIL=
CONTACT_WHATSAPP=
